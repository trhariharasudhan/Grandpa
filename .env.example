# Grandpa environment variables
# cp .env.example .env and fill in values
# Do not commit .env. It can contain local paths, tokens, and secrets.

# ---------------------------------------------------------------------------
# Inference
# ---------------------------------------------------------------------------

# Ollama HTTP endpoint used by local model routing.
# OLLAMA_HOST=http://127.0.0.1:11434

# Preferred default model for CLI/server chat.
# GRANDPA_MODEL=qwen2.5:3b

# Optional Gemma.cpp model file path.
# GEMMA_CPP_MODEL_PATH=

# Optional Gemma.cpp model type hint.
# GEMMA_CPP_MODEL_TYPE=

# Optional Gemma.cpp thread count.
# GEMMA_CPP_NUM_THREADS=

# ---------------------------------------------------------------------------
# Cloud providers
# ---------------------------------------------------------------------------

# OpenAI API key for cloud chat, Whisper, TTS, image, and compatible tools.
# OPENAI_API_KEY=sk-...

# Anthropic API key for Claude-compatible cloud routing.
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI API key for Gemini-compatible routing.
# GOOGLE_API_KEY=

# Gemini API key alias used by some cloud routes.
# GEMINI_API_KEY=

# OpenRouter API key for OpenAI-compatible hosted models.
# OPENROUTER_API_KEY=

# MiniMax API key for MiniMax cloud model routing.
# MINIMAX_API_KEY=

# OpenAI Codex API key for Codex-oriented model catalog entries.
# OPENAI_CODEX_API_KEY=

# Generic LLM API key used by OpenHands-style integrations.
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------

# Set to 1/true to opt out of analytics-style tracking where supported.
# DO_NOT_TRACK=1

# Set to 1/true to disable Grandpa analytics.
# GRANDPA_NO_ANALYTICS=1

# ---------------------------------------------------------------------------
# Update checks
# ---------------------------------------------------------------------------

# Set to 1 to disable Grandpa update checks.
# GRANDPA_NO_UPDATE_CHECK=1

# Set to 1/true in CI to suppress interactive update checks.
# CI=true

# ---------------------------------------------------------------------------
# Desktop/Tauri
# ---------------------------------------------------------------------------

# Tauri private signing key for production desktop updates; never commit a real key.
# TAURI_SIGNING_PRIVATE_KEY=

# Override Grandpa's local config/runtime home directory.
# GRANDPA_HOME=

# Runtime directory override for PC-control logs and local action state.
# GRANDPA_RUNTIME_DIR=

# ---------------------------------------------------------------------------
# Browser and browser agent
# ---------------------------------------------------------------------------

# Override browser context SQLite database path.
# GRANDPA_BROWSER_DB=

# Override browser agent task SQLite database path.
# GRANDPA_BROWSER_AGENT_DB=

# Inject active browser URL when OS active-window detection is unavailable.
# GRANDPA_BROWSER_ACTIVE_URL=

# Inline JSON browser context override for diagnostics/tests.
# GRANDPA_BROWSER_CONTEXT_JSON=

# File path containing browser context JSON for diagnostics/tests.
# GRANDPA_BROWSER_CONTEXT_FILE=

# ---------------------------------------------------------------------------
# Local databases and runtime stores
# ---------------------------------------------------------------------------

# Override autonomous agent goals SQLite database path.
# GRANDPA_AGENT_GOALS_DB=

# Override multi-agent task SQLite database path.
# GRANDPA_MULTI_AGENT_DB=

# Override knowledge engine SQLite database path.
# GRANDPA_KNOWLEDGE_DB=

# Force knowledge embeddings to fallback mode when local embeddings are unavailable.
# GRANDPA_KNOWLEDGE_EMBEDDING_MODE=fallback

# Override personal memory SQLite database path.
# GRANDPA_PERSONAL_MEMORY_DB=

# Override local PC-control SQLite database path.
# GRANDPA_PC_CONTROL_DB=

# Override local action audit log path.
# GRANDPA_LOCAL_ACTION_LOG=

# Override PC-control retention config path.
# GRANDPA_PC_CONTROL_RETENTION_CONFIG=

# Override clipboard history SQLite database path.
# GRANDPA_CLIPBOARD_HISTORY_DB=

# Override desktop operator SQLite database path.
# GRANDPA_DESKTOP_OPERATOR_DB=

# Override user-defined skill SQLite database path.
# GRANDPA_USER_SKILLS_DB=

# Override plugin state database/file path.
# GRANDPA_PLUGIN_STATE=

# Additional plugin search path.
# GRANDPA_PLUGIN_PATH=

# Skip release-gate lookup inside doctor for faster local diagnostics.
# GRANDPA_DOCTOR_SKIP_RELEASE_GATE=1

# ---------------------------------------------------------------------------
# Voice and speech
# ---------------------------------------------------------------------------

# Enable or disable transcript-gated wake phrase detection.
# GRANDPA_WAKE_WORD_ENABLED=true

# Comma-separated wake phrases for local transcript detection.
# GRANDPA_WAKE_WORDS=hey grandpa,grandpa

# Deepgram API key for optional speech recognition.
# DEEPGRAM_API_KEY=

# Cartesia API key for optional TTS.
# CARTESIA_API_KEY=

# ---------------------------------------------------------------------------
# Web search and external data
# ---------------------------------------------------------------------------

# Tavily API key for web search; DuckDuckGo fallback may work without it.
# TAVILY_API_KEY=

# Brave Search API key for optional connector setup.
# BRAVE_API_KEY=

# GitHub personal access token for GitHub connector setup.
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# PostgreSQL connection string for optional database connector setup.
# POSTGRES_CONNECTION_STRING=postgresql://user:pass@localhost:5432/db

# Google Maps API key for optional maps connector setup.
# GOOGLE_MAPS_API_KEY=

# Hugging Face token for optional gated evaluation datasets.
# HUGGINGFACE_HUB_TOKEN=

# ---------------------------------------------------------------------------
# Communication channels
# ---------------------------------------------------------------------------

# Slack bot token.
# SLACK_BOT_TOKEN=xoxb-...

# Slack app-level token.
# SLACK_APP_TOKEN=xapp-...

# Telegram bot token.
# TELEGRAM_BOT_TOKEN=

# Discord bot token.
# DISCORD_BOT_TOKEN=

# Email account username for email channel.
# EMAIL_USERNAME=

# Email account password or app password.
# EMAIL_PASSWORD=

# WhatsApp Cloud API access token.
# WHATSAPP_ACCESS_TOKEN=

# WhatsApp phone number ID.
# WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp webhook verify token.
# WHATSAPP_VERIFY_TOKEN=

# WhatsApp app secret for webhook validation.
# WHATSAPP_APP_SECRET=

# Signal bridge API URL.
# SIGNAL_API_URL=

# Signal CLI path for local Signal integrations.
# SIGNAL_CLI_PATH=

# Google Chat incoming webhook URL.
# GOOGLE_CHAT_WEBHOOK_URL=

# Microsoft Teams incoming webhook URL.
# TEAMS_WEBHOOK_URL=

# Teams app ID for bot-style integrations.
# TEAMS_APP_ID=

# Teams app password for bot-style integrations.
# TEAMS_APP_PASSWORD=

# BlueBubbles server URL.
# BLUEBUBBLES_SERVER_URL=

# BlueBubbles URL alias used by channel runtime.
# BLUEBUBBLES_URL=

# BlueBubbles password.
# BLUEBUBBLES_PASSWORD=

# Sendblue API key ID.
# SENDBLUE_API_KEY_ID=

# Sendblue API secret key.
# SENDBLUE_API_SECRET_KEY=

# Sendblue sender phone number.
# SENDBLUE_FROM_NUMBER=

# LINE channel access token.
# LINE_CHANNEL_ACCESS_TOKEN=

# LINE channel secret.
# LINE_CHANNEL_SECRET=

# Viber bot auth token.
# VIBER_AUTH_TOKEN=

# Viber bot display name.
# VIBER_BOT_NAME=Grandpa

# Viber bot avatar URL.
# VIBER_BOT_AVATAR=

# Messenger page access token.
# MESSENGER_PAGE_ACCESS_TOKEN=

# Messenger verify token.
# MESSENGER_VERIFY_TOKEN=

# Reddit API client ID.
# REDDIT_CLIENT_ID=

# Reddit API client secret.
# REDDIT_CLIENT_SECRET=

# Reddit username.
# REDDIT_USERNAME=

# Reddit password.
# REDDIT_PASSWORD=

# Mastodon access token.
# MASTODON_ACCESS_TOKEN=

# Mastodon API base URL.
# MASTODON_API_BASE_URL=https://mastodon.social

# Twitch OAuth token.
# TWITCH_TOKEN=

# Twitch channel name.
# TWITCH_CHANNEL=

# Twitch client ID.
# TWITCH_CLIENT_ID=

# Twitch access token alias used by channel runtime.
# TWITCH_ACCESS_TOKEN=

# Twitch bot nickname.
# TWITCH_NICK=

# Matrix homeserver URL.
# MATRIX_HOMESERVER=

# Matrix access token.
# MATRIX_ACCESS_TOKEN=

# Mattermost server URL.
# MATTERMOST_URL=

# Mattermost access token.
# MATTERMOST_TOKEN=

# Zulip bot email.
# ZULIP_EMAIL=

# Zulip API key.
# ZULIP_API_KEY=

# Zulip site URL.
# ZULIP_SITE=

# Zulip rc file path.
# ZULIP_RC=

# Rocket.Chat server URL.
# ROCKETCHAT_URL=

# Rocket.Chat user ID.
# ROCKETCHAT_USER_ID=

# Rocket.Chat username.
# ROCKETCHAT_USER=

# Rocket.Chat password.
# ROCKETCHAT_PASSWORD=

# Rocket.Chat auth token.
# ROCKETCHAT_AUTH_TOKEN=

# XMPP JID.
# XMPP_JID=

# XMPP password.
# XMPP_PASSWORD=

# XMPP server host.
# XMPP_SERVER=

# XMPP server port.
# XMPP_PORT=5222

# Feishu app ID.
# FEISHU_APP_ID=

# Feishu app secret.
# FEISHU_APP_SECRET=

# Nostr private key.
# NOSTR_PRIVATE_KEY=

# Nostr relay URLs, comma-separated.
# NOSTR_RELAYS=

# Twilio account SID.
# TWILIO_ACCOUNT_SID=

# Twilio auth token.
# TWILIO_AUTH_TOKEN=

# Twilio sender phone number.
# TWILIO_PHONE_NUMBER=

# IRC server host.
# IRC_SERVER=

# IRC server port.
# IRC_PORT=6667

# IRC nickname.
# IRC_NICK=grandpa

# IRC password, if the network requires one.
# IRC_PASSWORD=

# ---------------------------------------------------------------------------
# Evaluation and training helpers
# ---------------------------------------------------------------------------

# SWE-bench execution timeout in seconds.
# SWEBENCH_TIMEOUT_S=1800

# SWE-bench backend override.
# SWEBENCH_BACKEND=

# Hermes agent checkout path for evaluation runners.
# HERMES_AGENT_PATH=

# Terminal-Bench v2.1 repository path.
# TBV21_REPO_DIR=

# Keep PinchBench workspaces after execution for debugging.
# PINCHBENCH_KEEP_WORKSPACES=0

# WorkArena ServiceNow instance URL.
# SNOW_INSTANCE_URL=

# WebChoreArena GitLab URL.
# GITLAB=

# WebChoreArena judge model.
# JUDGE_MODEL=

# WebChoreArena map target.
# MAP=

# WebChoreArena Reddit target.
# REDDIT=

# WebChoreArena shopping target.
# SHOPPING=

# WebChoreArena Wikipedia target.
# WIKIPEDIA=

# Example secret key used only by security-scanner evaluation fixtures.
# SECRET_KEY=

# Example webhook secret used only by security-scanner evaluation fixtures.
# WEBHOOK_SECRET=

# Pearl model workspace path.
# PEARL_HOME=

# Pytest-injected current test marker; normally set by pytest itself.
# PYTEST_CURRENT_TEST=
