# Grandpa local Windows assistant environment variables
# Copy to .env only when an override is needed. Never commit .env.
#
# NOTE: Grandpa does not currently load .env itself — nothing in the codebase
# reads it. Treat this file as a reference list and export the variables in
# your shell (or set them in config.toml where an equivalent key exists).

# Local Ollama endpoint and default model.
# OLLAMA_HOST=http://127.0.0.1:11434
# GRANDPA_MODEL=grandpa-fast:latest

# Local API authentication. `grandpa serve` requires a bearer key by default
# and generates one into ~/.grandpa/config.toml ([server.auth] api_key) on
# first run. To pin a specific key instead, export this in your shell or set
# [server.auth] api_key in config.toml — per the note above, a value written
# here in .env is NOT picked up. `Grandpa_API_KEY` is the deprecated
# pre-rename spelling and is still read, with a warning.
# GRANDPA_API_KEY=gp_sk_...

# Local configuration and runtime paths.
# GRANDPA_HOME=C:\Users\YOUR_NAME\.grandpa
# GRANDPA_RUNTIME_DIR=C:\Users\YOUR_NAME\.grandpa\runtime
# GRANDPA_PERSONAL_MEMORY_DB=C:\Users\YOUR_NAME\.grandpa\personal_memory.db
# GRANDPA_PC_CONTROL_DB=C:\Users\YOUR_NAME\.grandpa\pc_control.db
# GRANDPA_LOCAL_ACTION_LOG=C:\Users\YOUR_NAME\.grandpa\local_actions.jsonl

# Voice and speech.
# GRANDPA_WAKE_WORD_ENABLED=true
# GRANDPA_WAKE_WORDS=hey grandpa,grandpa

# Browser control and awareness.
# GRANDPA_BROWSER_DB=C:\Users\YOUR_NAME\.grandpa\browser.db
# GRANDPA_BROWSER_AGENT_DB=C:\Users\YOUR_NAME\.grandpa\browser_agent.db
# GRANDPA_BROWSER_ACTIVE_URL=

# Optional local web search provider. DuckDuckGo may work without a key.
# TAVILY_API_KEY=

# Optional personal integrations use OAuth credentials under ~/.grandpa.
# Gmail: uv sync --extra gmail
# Calendar: uv sync --extra calendar

# Disable interactive update checks in automation.
# GRANDPA_NO_UPDATE_CHECK=1
# CI=true
